{
  "expo": {
    "name": "BoiskoPlus-mobile",
    "slug": "BoiskoPlus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/BoiskoPlusKonceptArt.jpg",
    "scheme": "boiskoplusmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/BoiskoPlusKonceptArt.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/BoiskoPlusKonceptArt.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": ["expo-router", "expo-secure-store", "@rnmapbox/maps"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "826ce042-408b-47a0-b6f6-5718e63e52b3"
      }
    }
  }
}
